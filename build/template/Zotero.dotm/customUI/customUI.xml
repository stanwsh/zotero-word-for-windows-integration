<?xml version="1.0"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui">
  <ribbon>
    <tabs>
      <tab id="ZoteroTab" getLabel="ZoteroRibbon.ZoteroTabLabel" insertBeforeMso="TabAddIns"
        keytip="C">
        <group id="ZoteroGroup" image="zoteroz16" label="Citations">
          <button id="InsertZoteroCitationButton" label="Add/Edit Citation" size="large"
            image="addEditZoteroCitation" onAction="ZoteroRibbon.ZoteroRibbonAddEditCitation"
            supertip="Insert a new citation, or edit the citation at the current cursor position"
            keytip="C" />
          <button id="GoToZotero" label="Go To Zotero" size="large" image="gotoZotero"
            onAction="ZoteroRibbon.ZoteroRibbonGoToZotero"
            supertip="Open the selected citation item in Zotero" keytip="G" />
          <button id="ZoteroRemoveCodes" label="Unlink Citations" size="large" image="removeZoteroCodes"
            onAction="ZoteroRibbon.ZoteroRibbonRemoveCodes"
            supertip="Remove all Zotero field codes and unlink from Zotero library" keytip="U" />
        </group>

        <group id="ZoteroGroup1" image="zoteroz16" label="Bibliography">
          <button id="InsertZoteroBibliographyButton" label="Add/Edit Bibliography" size="large"
            image="addEditZoteroBibliography"
            onAction="ZoteroRibbon.ZoteroRibbonAddEditBibliography"
            supertip="Insert a new bibliography, or edit the existing bibliography, at the current cursor position"
            keytip="B" />
          <button id="InsertZoteroNoteButton" label="Insert Note" size="large" image="addZoteroNote"
            onAction="ZoteroRibbon.ZoteroRibbonAddNote"
            supertip="Insert a new note at the current cursor position" keytip="N" />
        </group>

        <group id="ZoteroGroup2" image="zoteroz16" label="Tools">
          <button id="RefreshZotero" label="Refresh Citations" image="refreshZotero"
            onAction="ZoteroRibbon.ZoteroRibbonRefresh"
            supertip="Update all citations to reflect changes" keytip="R" />
          <button id="ZoteroSetDocPrefs" label="Preferences"
            image="setZoteroDocPrefs" onAction="ZoteroRibbon.ZoteroRibbonSetDocPrefs"
            supertip="Change the citation style or locale" keytip="P" />
          <!-- <button id="InsertZoteroCitationButtonSmall" visible="false" label="Add/Edit
          Citation" image="addEditZoteroCitation-small"
          onAction="ZoteroRibbon.ZoteroRibbonAddEditCitation" supertip="Insert a new citation, or
          edit the citation at the current cursor position"/>
	    <button id="InsertZoteroBibliographyButtonSmall" visible="false" label="Add/Edit Bibliography"
          size="large" image="addEditZoteroBibliography-small"
          onAction="ZoteroRibbon.ZoteroRibbonAddEditBibliography" supertip="Insert a new
          bibliography, or edit the existing bibliography, at the current cursor position"/>
          <button id="ZoteroSetDocPrefsLarge" visible="false" label="Document Preferences" size="large"
          image="setZoteroDocPrefs" onAction="ZoteroRibbon.ZoteroRibbonSetDocPrefs" supertip="Change
          the citation style or locale"/> -->
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>